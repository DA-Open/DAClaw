{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data_analysis result",
  "type": "object",
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "artifact_refs": {
      "type": "object",
      "properties": {"analysis": {"type": "string", "minLength": 1}},
      "required": ["analysis"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_action_receipts": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["summary", "artifact_refs", "evidence_refs"]
}
