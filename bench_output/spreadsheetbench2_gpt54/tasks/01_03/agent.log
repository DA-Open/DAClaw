    for r in range(1, min(ws.max_row,95)+1):
        vals=[]
        for c in range(1, min(ws.max_column,37)+1):
            v=ws.cell(r,c).value
            if v is not None:
                vals.append(f"{openpyxl.utils.get_column_letter(c)}{r}={v}")
        if vals and (s=='Ex 5 - M&A' and r<=35 or s=='Ex 1 - LBO' and 1<=r<=40):
            print(' | '.join(vals[:20]))
