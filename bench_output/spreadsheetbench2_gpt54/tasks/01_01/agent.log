from openpyxl import load_workbook
from pathlib import Path
inp=Path('/home/yangkuntao/DaraOS/bench_output/spreadsheetbench2_gpt54/tasks/01_01/input.xlsx')
out=Path('/home/yangkuntao/DaraOS/bench_output/spreadsheetbench2_gpt54/tasks/01_01/01_01_output.xlsx')
wb=load_workbook(inp)
# Fixes identified:
# 1) Ex 2 - Valuation Bridge C7 multiple expansion formula should use exit EBITDA, not exit multiple twice.
wb['Ex 2 - Valuation Bridge']['C7'] = "=('Ex 1 - LBO'!AC18-'Ex 1 - LBO'!X18)*'Ex 1 - LBO'!AC17"
# 2) Ex 1 - LBO C36 broken range reference D8:D8 should be scalar D8.
wb['Ex 1 - LBO']['C36'] = "='Ex 10 - Balance Sheet'!D8/C7"
# 3) Ex 1 - LBO IRR row missing first year formula at X29.
wb['Ex 1 - LBO']['X29'] = "=X28^(1/(P1-$P$1))-1"
# Preserve formatting via existing style (same row)
wb['Ex 1 - LBO']['X29']._style = wb['Ex 1 - LBO']['Y29']._style
wb['Ex 1 - LBO']['X29'].number_format = wb['Ex 1 - LBO']['Y29'].number_format
# 4) Ex 1 - LBO sensitivity seed values should be formulas instead of hardcoded inconsistent values.
# Premium vs Exit Multiple center exit multiple should tie to C20
wb['Ex 1 - LBO']['AI17'] = '=C20'
# Revenue Growth vs EBITDA Margin center assumptions should tie to operating assumptions
wb['Ex 1 - LBO']['AI26'] = '=M17'
wb['Ex 1 - LBO']['AI35'] = '=C20'
# M&A purchase multiple vs exit multiple center value should tie to M&A purchase multiple control
wb['Ex 1 - LBO']['AI44'] = '=C11'
# Copy styles from neighboring cells
ws=wb['Ex 1 - LBO']
for coord, neighbor in [('AI17','AH17'),('AI26','AH26'),('AI35','AH35'),('AI44','AH44')]:
    ws[coord]._style = ws[neighbor]._style
    ws[coord].number_format = ws[neighbor].number_format
# save
wb.save(out)
print(out.exists(), out)
