from openpyxl import load_workbook
from copy import copy
from pathlib import Path
infile=Path('/home/yangkuntao/DaraOS/bench_output/spreadsheetbench2_gpt54/tasks/01_02/input.xlsx')
outfile=Path('/home/yangkuntao/DaraOS/bench_output/spreadsheetbench2_gpt54/tasks/01_02/01_02_output.xlsx')
wb=load_workbook(infile)
ws=wb['Ex 1 - LBO']
ws['C36'] = "='Ex 10 - Balance Sheet'!D8/C7"
# replace unsupported _xlfn.RRI with equivalent CAGR formula
ws=wb['Ex 3 - PF P&L']
for coord in ['I13','I15','I19','I21','I25','I27']:
    row = ws[coord].row
    ws[coord] = f'=(G{row}/C{row})^(1/($G$1-$C$1))-1'
wb.save(outfile)
print('saved', outfile, outfile.exists(), outfile.stat().st_size)
