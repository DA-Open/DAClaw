from openpyxl import load_workbook
from openpyxl.utils import get_column_letter
wb=load_workbook('/home/yangkuntao/DaraOS/bench_output/spreadsheetbench2_gpt54/tasks/01_02/input.xlsx')
issues=[]
for ws in wb.worksheets:
    for row in ws.iter_rows():
        for cell in row:
            v=cell.value
            if isinstance(v,str) and v.startswith('='):
                if ':' in v and '/' in v and '!' in v and v.count(':')==1:
                    if any(seg in v for seg in ['D8:D8','E8:E8','F8:F8']):
                        issues.append((ws.title, cell.coordinate, v))
                if '_xlfn.RRI' in v:
                    issues.append((ws.title, cell.coordinate, v))
print('issue count', len(issues))
for i in issues[:50]:
    print(i)
